{
    "name": "myproject/quickstart",
    "require": {
        "php": ">=8.2",
        "temporal/sdk": "^2.20",
        "aws/aws-sdk-php": "^3.300"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "workflows/",
            "activities/",
            "client/",
            "workers/"
        ],
        "exclude-from-classmap": [
            "**/test.php",
            "**/test-client.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    }
}
