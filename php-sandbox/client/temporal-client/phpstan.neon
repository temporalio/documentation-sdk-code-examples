# Static analysis for the Client code on the Temporal Client page. The
# connection scripts can't run without the grpc extension, so PHPStan checks
# that every class, method, and named argument they use exists with the right
# types. Run from php-sandbox/:
#   vendor/bin/phpstan analyse -c client/temporal-client/phpstan.neon
#
# The Workflow interfaces aren't analysed directly: PHPStan reports their
# first line, which holds the Snipsync start marker inside `<?php ... ?>`, as
# "declare(strict_types) must be the very first statement", but PHP itself
# still enforces strict types there.
parameters:
    level: 5
    paths:
        - connect
        - ClientExamples.php
        - MoneyTransferExamples.php
