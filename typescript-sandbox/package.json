{
  "name": "temporal-hello-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "ts-node src/worker.ts",
    "start.watch": "nodemon src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "standalone-activity.worker": "ts-node src/activities/standalone/quickstart/worker.ts",
    "standalone-activity.execute": "ts-node src/activities/standalone/quickstart/execute.ts",
    "standalone-activity.start": "ts-node src/activities/standalone/start.ts",
    "standalone-activity.list": "ts-node src/activities/standalone/list.ts",
    "aws-lambda.build-workflow-bundle": "ts-node src/workers/serverless-workers/aws-lambda/scripts/build-workflow-bundle-otel.ts",
    "nexus.start.service": "ts-node src/nexus/feature-guide/service/worker.ts",
    "nexus.start.caller": "ts-node src/nexus/feature-guide/caller/worker.ts",
    "nexus.workflow": "ts-node src/nexus/feature-guide/starter.ts",
    "nexus-standalone.worker": "ts-node src/nexus/standalone-operations/worker/worker.ts",
    "nexus-standalone.starter": "ts-node src/nexus/standalone-operations/starter.ts",
    "build:protos": "pbjs -t json-module -w commonjs -r protobuf-sample -o src/best-practices/data-handling/data-conversion/protobufs/protos/json-module.js src/best-practices/data-handling/data-conversion/protobufs/protos/*.proto && pbjs -t static-module src/best-practices/data-handling/data-conversion/protobufs/protos/*.proto | pbts -o src/best-practices/data-handling/data-conversion/protobufs/protos/root.d.ts -",
    "test": "mocha --exit --node-option no-experimental-strip-types --require ts-node/register --require source-map-support/register src/mocha/*.test.ts src/best-practices/testing/test/*.test.ts"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^1.30.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.52.1",
    "@opentelemetry/propagator-jaeger": "^1.30.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/envconfig": "^1.25.0",
    "@temporalio/interceptors-opentelemetry": "1.25.0",
    "@temporalio/lambda-worker": "1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "@temporalio/workflow-streams": "^1.25.0",
    "async-mutex": "^0.5.0",
    "ejson": "^2.2.3",
    "nanoid": "3.x",
    "nexus-rpc": "0.0.3",
    "openai": "^7.47.0",
    "protobufjs": "^8.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.25.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/ejson": "^2.2.2",
    "@types/mocha": "10.x",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "mocha": "10.x",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "protobufjs-cli": "^2.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
